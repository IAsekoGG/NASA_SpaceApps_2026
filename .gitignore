# ---------------------------------------------------------------------------
# Raw and intermediate data (~39 GB): download/rebuild with pipeline/ and tools/
# ---------------------------------------------------------------------------
data/*
!data/README.md

# Keep small, human-readable results: tables and summaries (figures are regenerated by the scripts)
!data/analysis_rfi_clean/
data/analysis_rfi_clean/*
!data/analysis_rfi_clean/*.csv
!data/analysis_rfi_clean/*.json
!data/analysis_rfi_clean/*.txt

!data/analysis_timeseries/
data/analysis_timeseries/*
!data/analysis_timeseries/*.csv
!data/analysis_timeseries/*.txt

!data/analysis_143_A_025/
data/analysis_143_A_025/*
!data/analysis_143_A_025/*.csv
!data/analysis_143_A_025/*.txt

!data/s2_story/
data/s2_story/*
!data/s2_story/*.txt

# Heavy binary formats anywhere
*.h5
*.nc
*.npz
*.npy
*.tif
*.tiff
*.zip

# Images: not published. Only the web app's map layers (web/layers/) are tracked,
# because GitHub Pages serves them.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.pdf
*.mp4
!web/layers/**/*.png

# Report figures (working copies and final EN / UA sets)
report_figures/
report_figures_en/
Report figures (EN)/
Ілюстрації доповіді/

# Internal project notes (Obsidian) and candidate-area coverage checks.
# The Kakhovka URL lists stay: pipeline/ and tools/ read them.
/0[0-9] *.md
data_plan/*
!data_plan/kakhovka_urls_*.txt

# Notebook backups and checkpoints
ipynb/_backup/
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Credentials — never commit
.netrc
_netrc
.dodsrc
*.pem
.cloudflared/

# Editors / OS / tools
.obsidian/
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
desktop.ini
*.log
